# URL da API. Sem barra no final.
#
# Local:      http://localhost:8000
# Produção:   https://ca-api-<sufixo>.<região>.azurecontainerapps.io
#
# `NEXT_PUBLIC_` é obrigatório: a chamada acontece no navegador, e o Next só
# expõe ao cliente as variáveis com esse prefixo. Como vai para o bundle, aqui
# não entra segredo, e não precisa: a API é pública e sem autenticação.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Produção (Container App já no ar):
# NEXT_PUBLIC_API_URL=https://ca-api-conflwqwpg3yaypo2.wittyground-db3f9f26.brazilsouth.azurecontainerapps.io
