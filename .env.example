# Copie para .env (nunca versionado). No Azure esses valores viram env vars do
# Container App / Deployment, ou referências a secrets do Key Vault.

PORT=8000
CONFORMIDADE_ENVIRONMENT=local
CONFORMIDADE_LOG_LEVEL=DEBUG

# --- Preencher só na migração para Azure ---
# Client ID da user-assigned managed identity (usado por DefaultAzureCredential)
# CONFORMIDADE_AZURE_CLIENT_ID=
# CONFORMIDADE_KEY_VAULT_URI=https://kv-conformidade-dev.vault.azure.net/
# CONFORMIDADE_APP_CONFIG_ENDPOINT=https://ac-conformidade-dev.azconfig.io
# APPLICATIONINSIGHTS_CONNECTION_STRING=
